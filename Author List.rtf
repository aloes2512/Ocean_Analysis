<!--templates/classes/journal/registration/registration-in-steps/Renderers/Blocks/TitleBlockRenderer/index.mustache-->
<div class="form-group">
    <co-input
        type="text"
        name="title"
        label='Manuscript title<span class="edt_red_text text-danger">*</span>'
        show-label-colon="true"
        placeholder="Enter your manuscript title here."
        value=""
        input-id="title"
        input-class="edt_input_red  error-anchor-wrapper"
        max-length="700"
        autocomplete="off"
        framework="bootstrap"
        auto-validate="false"
        validation-message="Please enter the title."
        help-text=""
        show-character-count="false"
        layout="label-left"
        label-width="col-auto"
        input-width="col"
        wrapper-class="align-items-center"
        
    ></co-input>
</div>



        <script type="text/javascript">
        (function() {
            document.addEventListener('DOMContentLoaded', function() {
                var field = document.getElementById('title');
                if (!field) return;
                
                var messages = {"valueMissing":"Please enter the title.","tooShort":"Please enter the title.","tooLong":"Title must not exceed 700 characters."};
                
                field.addEventListener('invalid', function(e) {
                    var validity = e.target.validity;
                    var customMessage = '';
                    
                    // Check each validation state and use our custom message
                    for (var validationType in messages) {
                        if (validity[validationType]) {
                            customMessage = messages[validationType];
                            break;
                        }
                    }
                    
                    if (customMessage) {
                        e.target.setCustomValidity(customMessage);
                    }
                });
                
                // Clear custom message when user starts typing
                field.addEventListener('input', function(e) {
                    e.target.setCustomValidity('');
                });
            });
        })();
        </script><!--templates/classes/journal/registration/registration-in-steps/Renderers/Blocks/AuthorBlockRenderer/index.mustache-->
