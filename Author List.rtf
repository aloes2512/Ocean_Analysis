<script>
    $(document).ready(function(){
        
        typeof $.typeahead === "function" && $.typeahead({
            input: ".rorContainer .js-ror-typeahead-input",
            minLength: 3, //minimum character length
            maxItem: 20,
            dynamic: true,
            cache: false,
            searchOnFocus: true,
            //cancelButton: true,
            hint: true,
            display: "name",
            //highlight: false,
            filter:false,
            //templateValue: null,
            //template: "{{display}}, <small><em>{{group}}</em></small>",
            source:
            {
                ajax: {
                    method: "POST",
                    url: $(".rorContainer .typeahead__container").attr("data-u"),
                    data: { 
                        q: "{{query}}"
                    },  
                }
            },
            callback: {
                onResult: function (node, query, obj, objCount) {
                    //console.log(node, query, obj, objCount);
                    dispatchEvent(new CustomEvent("typeahead_onenter", {detail: query}));
                    if(obj.length > 0 && obj[obj.length-1].name === "limit")
                    {
                       obj.pop();
                       $("#rorMaxSearchReached").removeClass("d-none");
                    }
                    else
                    {
                        $("#rorMaxSearchReached").addClass("d-none");
                    }
                    
                    if(obj.length > 0){
                       dispatchEvent(new CustomEvent("typeahead_onresult"));
                    }
                },
                _onPopulateSource:function(a,results){
                    //console.debug("result:",a,results,results[results.length-1].display);
                },
                _onLayoutBuiltBefore: function (node, query, result, resultHtmlList) {
                    //console.debug(node, query, result, resultHtmlList);
                },
                onClickAfter: function (item, b, selected) {
                    $("#js-ror-typeahead-input-storage").val(selected.id);
                    $("#rorMaxSearchReached").addClass("d-none");
                    window.rorTableFill(item, b, selected);;
                },
                onCancel: function(){
                    $("#js-ror-typeahead-input-storage").val($("#js-ror-typeahead-input-storage").attr("data-default"));
                    $("#rorMaxSearchReached").addClass("d-none");
                }
            },
            debug: false
        });
    });
</script>
