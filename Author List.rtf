                            window.addCssToHeaduserBox('bootstrap-modal.css');
                            window.addCssToHeaduserBox('bootstrap-buttons.css');
                        window.modalShowProfile();
                    });
                } else {
                    window.addJSToHeaduserBox('https://cdn.copernicus.org/' + 'libraries/bootstrap/current/' + 'js/' + 'bootstrap.bundle.min.js', 'bootstrapDynamicalBundleMin').then(() => {
                        window.addJSToHeaduserBox('https://cdn.copernicus.org/' + 'libraries/bootstrap/current/' + 'js/' + 'popper.js', 'bootstrapDynamicalPopper').then(() => {
                                window.addCssToHeaduserBox('bootstrap-grid.css');
                                window.addCssToHeaduserBox('bootstrap-custom-elements.css');
                                window.addCssToHeaduserBox('bootstrap-form.css');
                                window.addCssToHeaduserBox('bootstrap-modal.css');
                                window.addCssToHeaduserBox('bootstrap-buttons.css');
                            window.modalShowProfile();
                        })
                    });
                }
        };
    }


    /**
     *
     * @param url
     */
    if(typeof addCssToHeaduserBox === 'undefined') {
        window.addCssToHeaduserBox = function (url) {
            let hasBootstrap = document.getElementById('hasBootstrap');

            if (!hasBootstrap) {
                let css = document.createElement('link');
                css.rel = 'stylesheet';
                css.type = 'text/css';
                css.setAttribute('href', 'https://cdn.copernicus.org/' + 'libraries/bootstrap/current/' + 'css/' + url);
                document.querySelector('head').appendChild(css);
            }
        };
    }


    /**
     *
     * @param url
     * @param id
     */
    if(typeof addJSToHeaduserBox === 'undefined') {
        window.addJSToHeaduserBox = function (url, id) {
            return new Promise((resolve, reject) => {
                let script = document.createElement('script');
                script.setAttribute('src', url);
                script.setAttribute('id', id);
                script.async = false;
                script.defer = false;
                document.querySelector('head').appendChild(script);

                let scriptBootstrap = document.getElementById(id);
                scriptBootstrap.addEventListener('load', function (event) {
                    resolve();
                });
            });
        }
    }

</script>

    <script>
        window.editFormSubmit = false;
        /**
         *
         */
        if(typeof window.modalShowProfile === 'undefined') {
             window.modalShowProfile = function (){
                $(function () {
                    /**
                     *
                     */
                    $(document).on('click', '.show-profile', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        $('.splash').fadeIn();
                        $('.lightbox').fadeIn();

                        $.ajax({
                            method: "GET",
                            url: "https://administrator.copernicus.org/webservices/UserRecords/getProfile.php?u=2b4353b4a87f56c3d3d59a1146e39466&p=5",
                            xhrFields: {
                                withCredentials: true
                            }
                        })
                                .done(function (data) {
                                    if(data.length > 100){
                                        $('#profileModal .modal-body .container-fluid').html(data);
                                        $('#profileModal').modal('toggle');
                                        $('.splash').fadeOut();
                                        $('.lightbox').fadeOut();
                                    } else {
                                        location.href = 'https://networker.copernicus.org/my-profile';
                                    }
                                })
                                .fail(function (error) {
                                    $('.splash').fadeOut();
                                    $('.lightbox').fadeOut();
                                    location.href = 'https://networker.copernicus.org/my-profile';
                                });
                    });

                    /**
                     *
                     */
                    $(document).on('click', '#profileModal .edit-profile.trigger-modal', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        $(document).on('shown.bs.modal', '#editProfileModal', function (e) {
                            dispatchEvent(new Event('load'));
                        });

                        const content = $('#editProfileModal .modal-body .container-fluid').html();

                        if(content.length > 100){
                            $('#editProfileModal').modal('toggle');
                        } else {
                            $('.splash').fadeIn();
                            $('.lightbox').fadeIn();

                            const element = $(this);
                            let url = $(element).data('url');

                            if(url.substr(-1, 1) === '/'){
                                location.href = url;
                            }

                            if(url.length > 0){
                                $.ajax({
                                    method: "GET",
                                    url: url + '/modal?ajax=2b4353b4a87f56c3d3d59a1146e39466',
                                    xhrFields: {
                                        withCredentials: true
                                    }
                                })
                                        .done(function (data) {
                                            let dataDecoded = null;
                                            try{
                                                dataDecoded = JSON.parse(data);
                                            } catch (e) {
                                                location.href = url;
                                            }

                                            if(dataDecoded !== null && dataDecoded.status === 200 && dataDecoded.message.length > 100){
                                                $('#editProfileModal .modal-body .container-fluid').html(dataDecoded.message);
                                                $('.splash').fadeOut();
                                                $('.lightbox').fadeOut();
                                                $('#editProfileModal').modal('toggle');
                                            } else {
                                                location.href = url;
                                            }

                                        })
                                        .fail(function (error) {
                                            $('.splash').fadeOut();
                                            $('.lightbox').fadeOut();
                                            location.href = url;
                                        });
                            }
                        }
                    });

                    /**
                     *
                     */
                    $(document).on('click', '#editProfileModal .close-edit-my-profile', function (event) {
                        $('#editProfileModal').modal('hide');
                    });

                    $(document).on('hidden.bs.modal', '#editProfileModal', function (e) {
                        $('body').addClass('modal-open');
                    });

                    /**
                     *
                     */
                    $(document).on('click', '#editProfileModal .save-my-profile', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();

                        dispatchEvent(new Event('load'));

                        let form = $('#editProfileModal .editProfileForm');

                        if (form.length > 0) {
                            window.editFormSubmit = true;
                            if(checkForm()){
                                $('.splash').fadeIn();
                                $('.lightbox').fadeIn();
                                $(form).submit();
                            }
                        }
                    });

                    /**
                     *
                     */
                    $(document).on('submit', '#editProfileModal .editProfileForm', function (event) {
                        event.preventDefault();
                        event.stopPropagation();
                        event.stopImmediatePropagation();
                        if (window.editFormSubmit) {

                            const element = $(this);
                            const form = document.querySelector('#editProfileModal .editProfileForm');
                            const formData = new FormData(form);
                            formData.append('ajax', '2b4353b4a87f56c3d3d59a1146e39466');
                            const url = $(element).attr('action');

                            if (url.length > 0) {
                                $.ajax({
                                    method: "POST",
                                    url: url + '/modal',
                                    xhrFields: {
                                        withCredentials: true
                                    },
                                    data: formData,
                                    processData: false,
                                    contentType: false,
                                    beforeSend: function(){
                                        $('.splash').fadeIn();
                                        $('.lightbox').fadeIn();
                                    }
                                })
                                        .done(function (data) {
                                            try{
                                                let dataDecoded = JSON.parse(data);
                                                if(dataDecoded.status === 200 && dataDecoded.message.length > 100){
                                                    $('.splash').fadeOut();
                                                    $('.lightbox').fadeOut();
                                                    $('#profileModal .modal-body .container-fluid').html(dataDecoded.message);
                                                    $('#editProfileModal').modal('toggle');
                                                }
                                            } catch (e) {
                                                $('.splash').fadeOut();
                                                $('.lightbox').fadeOut();
                                                alert("Your changes haven not been saved! Please try again.");
                                            }
                                        })
                                        .fail(function (error) {
                                            $('.splash').fadeOut();
                                            $('.lightbox').fadeOut();
                                            alert("Your changes haven not been saved! Please try again.");
                                        });
                            }

                        }
                        return false;
                    });
                });

                return true;
            }
        }

    </script>
