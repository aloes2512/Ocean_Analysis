<script>
    (function () {
        // Manual save functionality with AJAX using CoToast component
        var currentStep = parseInt('1') || 0;
        var actionUrl = '/EGUsphere/preprint-registration/journal/NPG';

        // AJAX save handler
        function handleManualSave(event) {
            // Check if the clicked element or its parent has the 'save' class
            var target = event.target;
            var saveButton = target.classList.contains('save') ? target : target.closest('.save');

            if (!saveButton) {
                return; // Not a save button, ignore
            }

            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();

            // Only allow save up to step 3
            if (currentStep > 3) {
                return false;
            }

            // Show lightbox and splash
            if (typeof window.showOverlay === 'function') {
                window.showOverlay();
            } else {
                $('#lightbox, #splash').fadeIn(150);
            }

            // Serialize form data
            var form = document.querySelector('.registration-step-' + currentStep);
            var formData = new FormData(form);

            // Add action parameter for save
            formData.append('save', 'save');

            // Perform AJAX request
            $.ajax({
                url: actionUrl,
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                dataType: 'json',
                success: function (response) {
                    // Hide spinner overlay
                    if (typeof window.hideOverlay === 'function') {
                        window.hideOverlay();
                    } else {
                        $('#lightbox, #splash').fadeOut(150);
                    }

                    // Show success toast using CoToast template
                    CoToast.showFromTemplate('#saveToastTemplate', {
                        type: 'success',
                        title: 'Success',
                        message: 'Manuscript registration saved.',
                        icon: 'fas fa-check-circle'
                    });
                },
                error: function (xhr, status, error) {
                    // Hide spinner overlay
                    if (typeof window.hideOverlay === 'function') {
                        window.hideOverlay();
                    } else {
                        $('#lightbox, #splash').fadeOut(150);
                    }

                    // Show error toast using CoToast template
                    CoToast.showFromTemplate('#saveToastTemplate', {
                        type: 'danger',
                        title: 'Error',
                        message: 'Failed to save manuscript registration. Please try again.',
                        icon: 'fas fa-exclamation-circle'
                    });

                    console.error('Save failed:', error);
                }
            });

            return false;
        }

        // Use event delegation: attach listener to document body to catch all .save button clicks
        // This works for buttons added to the DOM at any time (including dynamically added ones)
        document.body.addEventListener('click', handleManualSave, true);

        // Also prevent form submission if save button is clicked
        var form = document.querySelector('.registration-step-' + currentStep);
        if (form) {
            form.addEventListener('submit', function (event) {
                // Check if the submit was triggered by a save button
                var activeElement = document.activeElement;
                if (activeElement && activeElement.classList.contains('save')) {
                    event.preventDefault();
                    event.stopPropagation();
                    return false;
                }
            });
        }

        // Auto-Save Integration
            var autoSaveComponent = document.getElementById('registrationAutoSave');
            if (autoSaveComponent) {
                // Listen for successful auto-saves (just for logging)
                autoSaveComponent.addEventListener('co-save-success', function (event) {
                    // console.log('Auto-save successful:', event.detail);
                    // Toast is handled by component's show-toast attribute
                });

                // Listen for auto-save errors (just for logging)
                autoSaveComponent.addEventListener('co-save-error', function (event) {
                    // console.error('Auto-save failed:', event.detail.error, 'Attempt:', event.detail.attempt);
                    // Toast is handled by component's show-toast attribute
                });

                // Listen for retry attempts
                autoSaveComponent.addEventListener('co-retry-attempt', function (event) {
                    // console.log('Auto-save retry:', event.detail.attempt + '/' + event.detail.maxRetries);
                });

                // Listen for skipped saves
                autoSaveComponent.addEventListener('co-save-skipped', function (event) {
                    // console.log('Auto-save skipped:', event.detail.reason);
                });

                // Intercept auto-save requests to add the 'save' parameter
                // This ensures server knows it's an auto-save request
                var originalFetch = window.fetch;
                window.fetch = function (url, options) {
                    // Check if this is the auto-save request
                    if (url === '/index.php?_mdl=msreg_md&amp;_jrl=5&amp;_lcm=ms_reg_form&amp;_acm=auto_save&amp;salt=2938912511343940705' && options && options.body instanceof FormData) {
                        // Check if the request is from auto-save (not manual save)
                        var isAutoSave = options.body.get('save') === null;
                        if (isAutoSave) {
                            options.body.append('save', 'autosave');
                        }
                    }
                    return originalFetch.apply(this, arguments);
                };

                <!--console.log('Auto-save enabled for step 1');-->
            }
    })();
</script>
