<co-loading-spinner
    id="pageSpinner"
    overlay
    type="icon"
    icon="fas fa-spinner fa-spin fa-3x"
    framework="bootstrap"
    z-index="1500">
</co-loading-spinner>


<script type="module">
    // Wait for co-loading-spinner component to be defined before using it
    customElements.whenDefined('co-loading-spinner').then(() => {
        const spinner = document.getElementById('pageSpinner');

        // Hide spinner when window is fully loaded
        window.addEventListener('load', function() {
            setTimeout(() => {
                spinner.hide();
            }, 300);
        });

        // Global function for backward compatibility
        window.showOverlay = () => {
            spinner.show();
        };

        window.hideOverlay = () => {
            spinner.hide();
        };

        // Show spinner on form submission
        document.addEventListener('submit', function(e) {
            if (e.target.tagName === 'FORM') {
                spinner.show();
            }
        });

        // Show spinner on navigation clicks
        document.addEventListener('click', function(e) {
            const link = e.target.closest('.ms-header-action-buttons a');

            if (link) {
                // Optional: ignore anchors with target="_blank"
                if (link.target && link.target.toLowerCase() === '_blank') {
                    return; // let them open silently
                }

                // Optional: ignore pure hash links that don't navigate
                if (link.getAttribute('href') && link.getAttribute('href').startsWith('#')) {
                    return;
                }

                spinner.show();
            }
        });
    });
</script>

