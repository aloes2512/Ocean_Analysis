    // Clear Author List functionality
    // Wait for component to be defined before setting up event listeners
    customElements.whenDefined('co-confirmation-dialog').then(function() {
        const clearBtn = document.getElementById('clearAuthorListBtn');
        const clearDialog = document.getElementById('clearAuthorsDialog');

        if (clearBtn && clearDialog) {
            // Set up the clear action
            clearDialog.action = async () => {
                if (typeof window.showOverlay === 'function') {
                    window.showOverlay();
                }

                // Find the parent form
                const parentForm = clearBtn.closest('form');
                if (!parentForm) {
                    throw new Error('Parent form not found');
                }

                // Clear all author-related inputs
                const authorInputSelectors = [
                    'input[name^="author_first_name"]',
                    'input[name^="author_last_name"]',
                    'input[name^="author_email"]',
                    'input[name^="author_is_deceased"]',
                    'input[name^="author_has_no_first_name"]',
                    'input[name^="isCorrespondingAuthor"]',
                    'input[name^="noRORfound"]',
                    'input[name^="authorRor"]',
                    'select[name^="ror-country"]',
                    'input[name="correspondingAuthorPosition[]"]'
                ];

                // Clear all matching inputs
                authorInputSelectors.forEach(selector => {
                    const inputs = parentForm.querySelectorAll(selector);
                    inputs.forEach(input => {
                        if (input.type === 'checkbox' || input.type === 'radio') {
                            input.checked = false;
                        } else {
                            input.value = '';
                        }
                    });
                });

                // Add hidden input to signal clear authors action
                let clearInput = parentForm.querySelector('input[name="clear_authors"]');
                if (!clearInput) {
                    clearInput = document.createElement('input');
                    clearInput.type = 'hidden';
                    clearInput.name = 'clear_authors';
                    parentForm.appendChild(clearInput);
                }
                clearInput.value = '1';

                // Submit the form
                parentForm.submit();
            };

            // Open dialog when button is clicked
            clearBtn.addEventListener('click', function() {
                clearDialog.openDialog();
            });

            // Optional: Show success/error feedback
            clearDialog.addEventListener('co-confirmed', function() {
                // Form submission will reload page, so this might not be visible
                console.log('Clearing authors...');
            });

            clearDialog.addEventListener('co-error', function(e) {
                console.error('Failed to clear authors:', e.detail.error);
                alert('Failed to clear authors. Please try again.');
            });
        }
    });

    // CSV Upload validation - prevent form submission if no file selected
    (function() {
        const uploadBtn = document.getElementById('upload-author-list-btn');

        if (!uploadBtn) {
            return;
        }

        // Helper function to show alert message (with dialog or fallback)
        function showAlertMessage(title, message, dialogId, messageElementId) {
            const dialog = document.getElementById(dialogId);

            // Try to use co-confirmation-dialog if available
            if (dialog && typeof dialog.openDialog === 'function') {
                // If there's a message element, update it dynamically
                if (messageElementId) {
                    const messageElement = document.getElementById(messageElementId);
                    if (messageElement) {
                        messageElement.textContent = message;
                    }
                }
                dialog.openDialog();
            } else {
                // Fallback to native alert
                alert(title + '\n\n' + message);
            }
        }

        // Validation function
        function validateFileUpload(event) {
            const fileInput = document.getElementById('author-list-csv');

            // Check if file input exists and has files selected
            if (fileInput && fileInput.files.length === 0) {
                event.preventDefault();
                event.stopPropagation();
                showAlertMessage(
                    'No file selected',
                    'Please select a CSV or TXT file before uploading.',
                    'noFileSelectedDialog',
                    null
                );
                return false;
            }

            // Validate file extension
            if (fileInput && fileInput.files.length > 0) {
                const fileName = fileInput.files[0].name;
                const validExtensions = ['.csv', '.txt'];
                const fileExtension = fileName.substring(fileName.lastIndexOf('.')).toLowerCase();

                if (!validExtensions.includes(fileExtension)) {
                    event.preventDefault();
                    event.stopPropagation();
                    showAlertMessage(
                        'Invalid file type',
                        'Please select a valid CSV or TXT file. Selected file: ' + fileName,
                        'invalidFileTypeDialog',
                        'invalidFileMessage'
                    );
                    return false;
                }
            }
        }

        // Try to wait for co-confirmation-dialog to be defined
        if (typeof customElements !== 'undefined' && customElements.whenDefined) {
            // Set a timeout in case the component never loads
            const timeout = setTimeout(function() {
                console.warn('co-confirmation-dialog component did not load, using fallback alerts');
                uploadBtn.addEventListener('click', validateFileUpload);
            }, 5000);

            // Wait for component to be defined
            customElements.whenDefined('co-confirmation-dialog').then(function() {
                clearTimeout(timeout);
                uploadBtn.addEventListener('click', validateFileUpload);
            }).catch(function(error) {
                clearTimeout(timeout);
                console.error('Error loading co-confirmation-dialog:', error);
                uploadBtn.addEventListener('click', validateFileUpload);
            });
        } else {
            // customElements API not available, use fallback immediately
            console.warn('customElements API not available, using fallback alerts');
            uploadBtn.addEventListener('click', validateFileUpload);
        }
    })();
</script>
