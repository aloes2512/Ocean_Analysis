# Reconstruct clean harmonic pairs from residual SSA\
rec_res <- reconstruct(s_res, groups = list(\
  Hale_22yr    = c(1, 2),\
  Schwabe_11yr = c(3, 4),\
  Harmonic_5yr = c(5, 6),\
  Harmonic_3yr = c(7, 8)\
))\
\
# Combine the isolated Schwabe mode back with your solar-locked baseline\
